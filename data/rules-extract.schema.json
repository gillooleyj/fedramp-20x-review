{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fedramp-20x-review/rules-extract.schema.json",
  "title": "FedRAMP 20x Program Applicability Extract",
  "type": "object",
  "required": ["generated_at", "source", "profile", "default_artifacts", "classes"],
  "properties": {
    "generated_at": {"type": "string", "format": "date-time"},
    "source": {
      "type": "object",
      "required": ["dataset", "version", "last_updated", "sha256", "schema_validated"],
      "properties": {
        "version": {"type": "string", "pattern": "^\\d{4}\\.\\d{2}\\.\\d{2}\\.\\d{2}$"},
        "last_updated": {"type": "string", "format": "date"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "schema_validated": {"const": true},
        "commit": {"type": ["string", "null"]}
      }
    },
    "profile": {
      "type": "object",
      "required": ["type", "path"],
      "properties": {"type": {"const": "20x"}, "path": {"const": "Program"}}
    },
    "default_artifacts": {"type": "object"},
    "classes": {
      "type": "object",
      "required": ["a", "b", "c"],
      "additionalProperties": {"$ref": "#/$defs/classSet"}
    }
  },
  "$defs": {
    "force": {"enum": ["MUST", "MUST NOT", "SHOULD", "SHOULD NOT", "MAY"]},
    "classSet": {
      "type": "object",
      "required": ["class", "counts", "rules", "ksis", "other_actor_rules", "conflicts"],
      "properties": {
        "class": {"enum": ["a", "b", "c"]},
        "counts": {"type": "object"},
        "rules": {"type": "array", "items": {"$ref": "#/$defs/rule"}},
        "other_actor_rules": {"type": "array", "items": {"$ref": "#/$defs/rule"}},
        "ksis": {"type": "array", "items": {"$ref": "#/$defs/ksi"}},
        "conflicts": {
          "type": "array",
          "items": {"type": "object", "required": ["id", "issue"]}
        }
      }
    },
    "rule": {
      "type": "object",
      "required": ["id", "kind", "name", "json_path", "statement", "force", "affects", "basis", "statement_sha256"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z]{3}-[A-Z]{3}-[A-Z0-9]{3}$"},
        "kind": {"const": "FRR"},
        "statement": {"type": "string", "minLength": 1},
        "force": {"$ref": "#/$defs/force"},
        "overlay_force": {"$ref": "#/$defs/force"},
        "statement_force": {"$ref": "#/$defs/force"},
        "affects": {"type": "array", "items": {"enum": ["Providers", "Agencies", "Assessors", "Advisors", "FedRAMP", "Trust Centers"]}},
        "basis": {"type": "array", "minItems": 1, "items": {"enum": ["subset", "FRC-CLA-MFR", "FRC-CLA-RFR", "FRC-CLA-OFR", "unscoped"]}},
        "artifacts": {"type": "array", "items": {"type": "string"}},
        "statement_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "ksi": {
      "type": "object",
      "required": ["id", "kind", "name", "json_path", "statement", "optional", "basis", "statement_sha256"],
      "properties": {
        "id": {"type": "string", "pattern": "^KSI-[A-Z]{3}-[A-Z0-9]{3}$"},
        "kind": {"const": "KSI"},
        "statement": {"type": "string", "minLength": 1},
        "optional": {"type": "boolean"},
        "overlay_force": {"oneOf": [{"$ref": "#/$defs/force"}, {"type": "null"}]},
        "statement_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
